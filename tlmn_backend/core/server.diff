+def afk_back(req: AfkBackRequest):
+    """Người đang bị Bot đánh giúp (AFK: hai lần liên tục để hết giờ lượt thật, hoặc máy không phản hồi) đã QUAY LẠI -> Frontend gọi đây
+    ngay khi họ chạm / bấm phím / mở lại tab. Backend xoá cờ AFK để họ tự đánh tiếp; đúng lượt của họ thì được đủ thời gian nghĩ.
+    Không có gì để trả (không AFK / không còn ghế) cũng không phải lỗi: { status:'success', cleared:false }."""
+    room = room_manager.find_room((req.room_id or "").strip())
+    if room is None:
+        return {"status": "error", "code": "closed", "message": "Phòng đã đóng hoặc không tồn tại."}
+    return room.clear_afk(req.username)
